# Django Settings
DJANGO_SECRET_KEY=your-secure-secret-key-here-change-this
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=194.67.124.178,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://194.67.124.178,https://194.67.124.178

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cloud_storage
DB_USER=cloud_user
DB_PASSWORD=your-secure-database-password-here
DB_HOST=localhost
DB_PORT=5432

# Security
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# CORS
CORS_ALLOWED_ORIGINS=http://194.67.124.178,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# File Storage
MEDIA_ROOT=/opt/cloud_storage/media
MAX_UPLOAD_SIZE=52428800
FILE_UPLOAD_PERMISSIONS=644

# Logging
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
ROOT_LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
ACCOUNTS_LOG_LEVEL=INFO